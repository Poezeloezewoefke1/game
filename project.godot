; Engine configuration file.
; Godot 4.5.1-stable — see docs/TECH_STACK.md for the version pin rationale.

config_version=5

[application]

config/name="Starbound Station: The Lost Signal"
config/description="A 1-4 player cooperative third-person space adventure."
config/version="0.5.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"
run/max_fps=0

[autoload]

GameConfig="*res://scripts/core/game_config.gd"
Logx="*res://scripts/utility/logx.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
NetworkManager="*res://scripts/multiplayer/network_manager.gd"
LobbyManager="*res://scripts/multiplayer/lobby_manager.gd"
SceneManager="*res://scripts/core/scene_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
SpawnManager="*res://scripts/multiplayer/spawn_manager.gd"
LanDiscovery="*res://scripts/multiplayer/lan_discovery.gd"
AudioDirector="*res://scripts/core/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

