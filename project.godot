[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="enemy"
3d_physics/layer_5="projectile"
3d_physics/layer_6="player_hurtbox"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.2

[physics]

3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)
